{
  "name": "twins-through-time",
  "version": "1.0.0",
  "description": "Twins Through Time - Full Stack Application",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
